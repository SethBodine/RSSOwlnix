      Eclipse Public License - v 1.0
   </license>

   <requires>
      <import plugin="org.rssowl.core" version="2.10.4" match="greaterOrEqual"/>
      <import plugin="org.rssowl.ui" version="2.10.4" match="greaterOrEqual"/>
   </requires>

   <plugin
         id="org.rssowl.core.nls.pt"
         download-size="0"
         install-size="0"
         version="0.0.0"
         fragment="true"
         unpack="false"/>

